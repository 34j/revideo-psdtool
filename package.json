{
  "name": "revideo-psdtool",
  "type": "commonjs",
  "version": "0.0.0",
  "description": "Minimalistic npm package template with 📦🚀semantic-release + Commitizen, CodeCov, Renovate, pre-commit + EsLint (✗🐶Husky + Lint Staged), ⚡️Vitest (✗👢Jest), 📖TypeDoc + Github Pages support. Note that this is a generated sample package.",
  "author": {
    "name": "34j"
  },
  "license": "MIT",
  "homepage": "https://github.com/34j/revideo-psdtool",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/34j/revideo-psdtool.git"
  },
  "bugs": {
    "url": "https://github.com/34j/revideo-psdtool/issues"
  },
  "keywords": [
    "boilerplate",
    "template",
    "typescript",
    "vitest",
    "pre-commit",
    "semantic-release",
    "typedoc"
  ],
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist/src/**/*"
  ],
  "scripts": {
    "build:watch": "tsc --watch --project tsconfig.json",
    "preinstall": "npx only-allow pnpm",
    "build": "tsc --project tsconfig.json",
    "lint": "eslint --fix",
    "typedoc": "typedoc",
    "typedoc:watch": "typedoc --watch",
    "test:watch": "vitest --watch --coverage --coverage.include=src",
    "test": "vitest --coverage --coverage.include=src",
    "watch": "npm-run-all --race --parallel *:watch",
    "update": "npm-check-updates -u",
    "semantic-release": "semantic-release",
    "start": "revideo editor --projectFile ./demo/project.tsx",
    "render": "tsc --project tsconfig.json && node dist/render.js"
  },
  "typedocOptions": {
    "entryPoints": [
      "src"
    ],
    "tsconfig": "tsconfig.json",
    "headings": false
  },
  "release": {
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      "@semantic-release/npm",
      [
        "@semantic-release/git",
        {
          "assets": [
            "CHANGELOG.md",
            "README.md",
            "package.json",
            "package-lock.json"
          ]
        }
      ],
      "@semantic-release/github"
    ]
  },
  "dependencies": {
    "@preact/signals": "^2.5.1",
    "@revideo/2d": "^0.10.4",
    "@revideo/core": "^0.10.4",
    "@revideo/renderer": "^0.10.4",
    "ag-psd": "^29.0.0",
    "ag-psd-psdtool": "^1.1.4",
    "preact": "^10.28.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "6.1.0",
    "@revideo/cli": "^0.10.4",
    "@revideo/ui": "^0.10.4",
    "@tsconfig/strictest": "2.0.6",
    "@types/node": "24.9.1",
    "@typescript-eslint/eslint-plugin": "8.46.2",
    "@vitest/browser": "4.0.3",
    "@vitest/browser-playwright": "4.0.3",
    "@vitest/coverage-v8": "4.0.3",
    "eslint": "9.38.0",
    "npm-run-all2": "8.0.4",
    "playwright": "1.56.1",
    "typedoc": "0.28.14",
    "typescript": "5.9.3",
    "vite": "^7.3.0",
    "vitest": "4.0.3"
  }
}
